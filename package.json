{
  "name": "tree-sitter-webvtt",
  "version": "1.2.0",
  "description": "Tree-sitter grammar for WebVTT subtitles and captions",
  "license": "MIT",
  "author": "Marcus Linder <mlinder@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlinder/tree-sitter-webvtt.git"
  },
  "keywords": ["tree-sitter", "parser", "webvtt", "vtt", "subtitles", "captions"],
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "parse": "tree-sitter parse",
    "build:wasm": "tree-sitter build --wasm",
    "test": "tree-sitter test && tree-sitter parse --quiet examples/* && node --test bindings/node/*_test.js"
  },
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "node-gyp": "13.1.0",
    "prebuildify": "6.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.2"
  }
}
